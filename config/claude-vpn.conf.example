# ============================================================
# ClaudeCage Configuration File
#
# КРИТИЧНЫЕ ПАРАМЕТРЫ СЕТИ (VPN_IFACE, VPN_DNS):
# Должны задаваться ТОЛЬКО в /etc/claude-vpn.conf (владелец: root:root, 0644).
# Это исключает возможность переопределения шлюза кодом из клетки.
#
# ПОЛЬЗОВАТЕЛЬСКИЕ НАСТРОЙКИ (CLAUDE_TZ):
# Могут быть переопределены в ~/.config/claude-vpn.conf.
# ============================================================

# Целевой сетевой интерфейс VPN-туннеля (по умолчанию: amn0)
# Примеры: WireGuard (wg0), OpenVPN (tun0), AmneziaVPN (amn0), ProtonVPN (proton0)
VPN_IFACE="amn0"

# Целевой DNS-резолвер туннеля (по умолчанию: 100.64.0.1 для Amnezia, 1.1.1.1 или 10.2.0.1 для WireGuard)
VPN_DNS="100.64.0.1"

# Часовой пояс окружения для антифрода (должен совпадать с геолокацией VPN-сервера выхода)
CLAUDE_TZ="Europe/Amsterdam"
