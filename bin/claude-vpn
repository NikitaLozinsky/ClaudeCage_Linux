#!/bin/bash
# ==============================================================================
# claude-vpn — Hardened Network Jail for Claude (CLI & GUI)
#
# Режимы работы:
#   claude-vpn --up               Поднять netns, veth, policy routing, nftables и watchdog (фон)
#   claude-vpn --down             Полностью удалить netns, правила и watchdog
#   claude-vpn <приложение>       Запустить приложение в изолированном netns
#   claude-vpn --status           Статус netns, VPN, routing и watchdog
#
# Особенности безопасности (Эшелонированная оборона):
#   - Двухуровневый Fail-Closed: Policy Routing (table 200) + Аппаратный nftables
#   - Атомарная транзакция nftables: исключено окно без файрвола при старте/реконнекте
#   - Изоляция сессионной шины: маскировка ${XDG_RUNTIME}/bus, systemd --user, gnupg
#   - Защита от LPE и подмены маршрутов: критичные ключи только из /etc/claude-vpn.conf
#   - Dynamic MSS: clamp rt mtu для туннеля без фрагментации
#   - Reconcile Watchdog: Netlink link monitor + liveness-проба + авто-исцеление nftables
#   - Безопасный сброс сокетов (ss -K): уничтожение внешних TCP/UDP без сброса 127.0.0.1
#   - Полная изоляция IPv6 (disable_ipv6=1 на netns и veth_host)
# ==============================================================================
set -uo pipefail

# ── Определение путей и конфигурация ────────────────────────
SCRIPT_PATH="/usr/local/bin/claude-vpn"
NETNS="claude_vpn"
VETH_HOST="veth_host"
VETH_NS="veth_ns"
SUBNET="10.200.1"
HOST_IP="${SUBNET}.1"
NS_IP="${SUBNET}.2"
PREFIX="24"
RT_TABLE=200
RT_PRIO=100
DEFAULT_MTU=1376
NFT_TABLE="claude_vpn_nat"
PID_FILE="/run/claude_vpn_watchdog.pid"
ORIG_FWD_FILE="/run/claude_vpn_orig_ip_forward"
JAIL_XDG_OPEN="/usr/local/lib/claude-vpn/xdg-open-jail"

# Определение пользователя и домашней директории
REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || who -m 2>/dev/null | awk '{print $1}' || id -un)}"
REAL_UID=$(id -u "$REAL_USER" 2>/dev/null || echo 1000)
REAL_GID=$(id -g "$REAL_USER" 2>/dev/null || echo 1000)
REAL_HOME=$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6)
[[ -z "$REAL_HOME" ]] && REAL_HOME="/home/${REAL_USER}"
XDG_RUNTIME="/run/user/${REAL_UID}"

# Конфигурация по умолчанию
VPN_IFACE="amn0"
VPN_DNS="100.64.0.1"
CLAUDE_TZ="Europe/Amsterdam"

# 1. Чтение системного доверенного конфига root (/etc/claude-vpn.conf)
# КРИТИЧНЫЕ СЕТЕВЫЕ КЛЮЧИ ЧИТАЮТСЯ ТОЛЬКО ОТСЮДА!
if [[ -f "/etc/claude-vpn.conf" ]]; then
    _v=$(grep -E "^VPN_IFACE=" "/etc/claude-vpn.conf" 2>/dev/null | tail -n1 | cut -d"=" -f2- | sed -e "s/['\" ]//g")
    if [[ "$_v" =~ ^[a-z0-9_.-]{1,15}$ ]]; then
        VPN_IFACE="$_v"
    fi
    _v=$(grep -E "^VPN_DNS=" "/etc/claude-vpn.conf" 2>/dev/null | tail -n1 | cut -d"=" -f2- | sed -e "s/['\" ]//g")
    if [[ "$_v" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
        VPN_DNS="$_v"
    fi
    _v=$(grep -E "^CLAUDE_TZ=" "/etc/claude-vpn.conf" 2>/dev/null | tail -n1 | cut -d"=" -f2- | sed -e "s/['\" ]//g")
    if [[ "$_v" =~ ^[A-Za-z0-9_+-]+/[A-Za-z0-9_+-]+$ ]]; then
        CLAUDE_TZ="$_v"
    fi
fi

# 2. Пользовательский конфиг: считываем ИСКЛЮЧИТЕЛЬНО CLAUDE_TZ
if [[ -f "${REAL_HOME}/.config/claude-vpn.conf" ]]; then
    _v=$(grep -E "^CLAUDE_TZ=" "${REAL_HOME}/.config/claude-vpn.conf" 2>/dev/null | tail -n1 | cut -d"=" -f2- | sed -e "s/['\" ]//g")
    if [[ "$_v" =~ ^[A-Za-z0-9_+-]+/[A-Za-z0-9_+-]+$ ]]; then
        CLAUDE_TZ="$_v"
    fi
fi

# ── Цвета оформления ────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${GREEN}[✓]${NC} $1"; }
warn()  { echo -e "${YELLOW}[!]${NC} $1"; }
err()   { echo -e "${RED}[✗]${NC} $1" >&2; }
step()  { echo -e "${CYAN}━━━ $1 ━━━${NC}"; }

# ── Проверка прав (авто-элевация через sudo) ────────────────
check_root() {
    if [[ $EUID -ne 0 ]]; then
        exec sudo "$SCRIPT_PATH" "$@"
    fi
}

# ── Проверка статуса VPN ────────────────────────────────────
vpn_is_up() {
    ip link show dev "$VPN_IFACE" &>/dev/null
}

vpn_has_carrier() {
    ip -o link show dev "$VPN_IFACE" 2>/dev/null | grep -q "LOWER_UP"
}

vpn_has_ip() {
    ip -4 -o addr show dev "$VPN_IFACE" 2>/dev/null | grep -q "inet "
}

vpn_get_ip() {
    ip -4 -o addr show dev "$VPN_IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1
}

# ── Определение MTU ─────────────────────────────────────────
get_vpn_mtu() {
    local mtu
    mtu=$(ip -o link show dev "$VPN_IFACE" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="mtu") print $(i+1)}')
    echo "${mtu:-$DEFAULT_MTU}"
}

# ── Проверка: netns существует? ─────────────────────────────
netns_exists() {
    ip netns list 2>/dev/null | grep -qw "$NETNS"
}

# ── Policy Routing (Второй рубеж обороны ядра) ──────────────
policy_up() {
    step "Настройка Policy Routing (table $RT_TABLE, prio $RT_PRIO)"
    if ! ip rule show 2>/dev/null | grep -q "^${RT_PRIO}:.*iif ${VETH_HOST}"; then
        ip rule add iif "$VETH_HOST" priority "$RT_PRIO" lookup "$RT_TABLE"
        info "Добавлено правило policy routing: iif $VETH_HOST lookup $RT_TABLE (prio $RT_PRIO)"
    fi
    # Перманентный fail-closed маршрут с наивысшей метрикой
    ip route replace unreachable default table "$RT_TABLE" metric 9999
    info "Установлен fail-closed fallback: unreachable default table $RT_TABLE (metric 9999)"
}

vpn_route() {
    if vpn_is_up; then
        ip route replace default dev "$VPN_IFACE" table "$RT_TABLE" metric 10 2>/dev/null || true
    else
        ip route del default dev "$VPN_IFACE" table "$RT_TABLE" metric 10 2>/dev/null || true
    fi
}

policy_down() {
    step "Очистка Policy Routing (table $RT_TABLE)"
    while ip rule del priority "$RT_PRIO" 2>/dev/null; do :; done
    ip route flush table "$RT_TABLE" 2>/dev/null || true
    info "Таблица $RT_TABLE и правила iif $VETH_HOST очищены"
}

# ── Поднять netns + veth + MTU + маршруты + DNS ────────────
setup_netns() {
    step "Создание netns: $NETNS (Hardened Kill Switch изоляция)"
    local vpn_mtu
    vpn_mtu=$(get_vpn_mtu)

    # 1. Создать namespace
    if ! netns_exists; then
        ip netns add "$NETNS"
        info "Namespace $NETNS создан"
    fi

    # 2. Поднять lo внутри netns
    ip netns exec "$NETNS" ip link set lo up

    # 3. Полностью отключить IPv6 внутри netns для защиты от утечек
    ip netns exec "$NETNS" sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1 || true
    ip netns exec "$NETNS" sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1 || true
    ip netns exec "$NETNS" sysctl -w net.ipv6.conf.lo.disable_ipv6=1 >/dev/null 2>&1 || true
    info "IPv6 внутри netns $NETNS полностью отключён"

    # 4. Создать veth-пару с MTU
    if ! ip link show "$VETH_HOST" &>/dev/null; then
        ip link add "$VETH_HOST" mtu "$vpn_mtu" type veth peer name "$VETH_NS" mtu "$vpn_mtu"
        info "veth-пара создана: $VETH_HOST <-> $VETH_NS (MTU: $vpn_mtu)"
    else
        ip link set "$VETH_HOST" mtu "$vpn_mtu" 2>/dev/null || true
    fi

    # 5. Переместить veth_ns в netns
    if ip link show "$VETH_NS" &>/dev/null; then
        ip link set "$VETH_NS" netns "$NETNS"
    fi

    # 6. Настроить хостовую сторону veth
    ip addr flush dev "$VETH_HOST" 2>/dev/null || true
    ip addr add "${HOST_IP}/${PREFIX}" dev "$VETH_HOST"
    ip link set "$VETH_HOST" mtu "$vpn_mtu" up

    # rp_filter строго на veth_host (не трогая глобальный all.rp_filter)
    sysctl -w "net.ipv4.conf.${VETH_HOST}.rp_filter=1" >/dev/null 2>&1 || true
    # Полное отключение IPv6 на хостовом конце veth
    sysctl -w "net.ipv6.conf.${VETH_HOST}.disable_ipv6=1" >/dev/null 2>&1 || true

    # 7. Настроить сторону netns
    ip netns exec "$NETNS" ip link set "$VETH_NS" mtu "$vpn_mtu" up
    ip netns exec "$NETNS" ip addr flush dev "$VETH_NS" 2>/dev/null || true
    ip netns exec "$NETNS" ip addr add "${NS_IP}/${PREFIX}" dev "$VETH_NS"

    # 8. Статический маршрут по умолчанию внутри netns (решение принимает хост через table 200)
    ip netns exec "$NETNS" ip route replace default via "$HOST_IP" dev "$VETH_NS"
    info "Статический default route внутри netns установлен (via $HOST_IP dev $VETH_NS)"

    # 9. DNS внутри netns строго через VPN_DNS
    mkdir -p "/etc/netns/${NETNS}"
    cat > "/etc/netns/${NETNS}/resolv.conf" << EOF
# DNS для netns $NETNS
nameserver $VPN_DNS
EOF
    info "DNS настроен: $VPN_DNS (/etc/netns/${NETNS}/resolv.conf)"

    # 10. Сохранить текущее значение и включить ip_forward на хосте
    local orig_fwd
    orig_fwd=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo 0)
    echo "$orig_fwd" > "$ORIG_FWD_FILE"
    sysctl -w net.ipv4.ip_forward=1 > /dev/null

    # 11. Настроить Policy Routing
    policy_up
    vpn_route

    # 12. Настроить правила nftables
    setup_nftables
}

# ── nftables: Атомарная загрузка правил NAT и Kill Switch ──
setup_nftables() {
    step "Настройка правил nftables (атомарная загрузка транзакцией)"

    # Атомарная замена в одной транзакции (исключено окно без файрвола)
    nft -f - << NFT_RULES
table inet $NFT_TABLE
delete table inet $NFT_TABLE
table inet $NFT_TABLE {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        # Перехват любого DNS (порт 53 UDP/TCP) из клетки на VPN_DNS
        iifname "${VETH_HOST}" meta l4proto { tcp, udp } th dport 53 dnat ip to ${VPN_DNS}:53
    }
    chain input {
        type filter hook input priority -10; policy accept;
        meta nfproto ipv6 iifname "${VETH_HOST}" drop
        iifname "${VETH_HOST}" ct state established,related accept
        iifname "${VETH_HOST}" ip protocol icmp icmp type echo-request ip daddr ${HOST_IP} accept
        # Запретить доступ из клетки к локальным сервисам хоста
        iifname "${VETH_HOST}" drop
    }
    chain forward {
        type filter hook forward priority -10; policy drop;
        meta nfproto ipv6 iifname "${VETH_HOST}" drop
        meta nfproto ipv6 oifname "${VETH_HOST}" drop
        ct state invalid drop

        # ЖЕСТКИЙ KILL SWITCH С ИМЕНОВАННЫМ СЧЕТЧИКОМ (СТРОГО ВЫШЕ ct established accept!)
        iifname "${VETH_HOST}" oifname != "${VPN_IFACE}" counter drop

        # Динамический MSS по MTU маршрута только для трафика клетки
        iifname "${VETH_HOST}" oifname "${VPN_IFACE}" tcp flags syn tcp option maxseg size set rt mtu
        iifname "${VPN_IFACE}" oifname "${VETH_HOST}" tcp flags syn tcp option maxseg size set rt mtu

        iifname "${VETH_HOST}" oifname "${VPN_IFACE}" accept
        iifname "${VPN_IFACE}" oifname "${VETH_HOST}" ct state established,related accept
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        # NAT строго через VPN_IFACE
        ip saddr ${SUBNET}.0/${PREFIX} oifname "${VPN_IFACE}" masquerade
    }
}
NFT_RULES

    # Интеграция с существующим inet filter forward (если на хосте default policy drop)
    if nft list chain inet filter forward &>/dev/null; then
        for handle in $(nft -a list chain inet filter forward 2>/dev/null | grep -E 'claude-vpn' | awk '{print $NF}'); do
            nft delete rule inet filter forward handle "$handle" 2>/dev/null || true
        done
        nft insert rule inet filter forward iifname "${VPN_IFACE}" oifname "${VETH_HOST}" ct state established,related accept comment "claude-vpn" 2>/dev/null || true
        nft insert rule inet filter forward iifname "${VETH_HOST}" oifname "${VPN_IFACE}" accept comment "claude-vpn" 2>/dev/null || true
    fi

    info "Таблица $NFT_TABLE загружена атомарно (Priority -10, Fail-Closed, Drop counter, rt mtu, DNS dnat)"
}

# ── Проверка связности ──────────────────────────────────────
verify_connectivity() {
    step "Проверка связности и DNS"

    if ! vpn_is_up; then
        warn "VPN ($VPN_IFACE) отключён. Проверка внешнего интернета пропущена (Kill Switch активен)."
        return 0
    fi

    local all_ok=true

    # 1. Пинг шлюза на хосте
    if ip netns exec "$NETNS" ping -c 1 -W 2 "$HOST_IP" &>/dev/null; then
        info "Пинг хост-шлюза ($HOST_IP): OK"
    else
        warn "Пинг хост-шлюза ($HOST_IP): FAIL"
        all_ok=false
    fi

    # 2. Пинг внешнего IP (1.1.1.1) через VPN
    if ip netns exec "$NETNS" ping -c 2 -W 3 1.1.1.1 &>/dev/null; then
        info "Пинг 1.1.1.1 (ICMP через VPN): OK"
    else
        warn "Пинг 1.1.1.1: FAIL"
        all_ok=false
    fi

    # 3. Проверка DNS через VPN_DNS
    if command -v dig &>/dev/null; then
        local dns_res
        dns_res=$(ip netns exec "$NETNS" dig +short +time=3 +tries=2 @${VPN_DNS} google.com 2>/dev/null | head -n1 || echo "")
        if [[ -n "$dns_res" ]]; then
            info "DNS резолв (@${VPN_DNS} google.com -> $dns_res): OK"
        else
            warn "DNS резолв (@${VPN_DNS} google.com): FAIL"
            all_ok=false
        fi

        # Проверка прозрачного перехвата стороннего DNS (dnat)
        local dnat_res
        dnat_res=$(ip netns exec "$NETNS" dig +short +time=3 +tries=2 @8.8.8.8 google.com 2>/dev/null | head -n1 || echo "")
        if [[ -n "$dnat_res" ]]; then
            info "Перехват стороннего DNS (@8.8.8.8 -> DNAT $VPN_DNS): OK ($dnat_res)"
        else
            warn "Перехват стороннего DNS: FAIL"
            all_ok=false
        fi
    fi

    # 4. Проверка системного DNS netns
    if ip netns exec "$NETNS" getent hosts google.com &>/dev/null || ip netns exec "$NETNS" getent hosts ifconfig.me &>/dev/null; then
        info "Системный DNS netns (/etc/resolv.conf): OK"
    else
        warn "Системный DNS netns: FAIL"
        all_ok=false
    fi

    # 5. Проверка внешнего IP через curl (с резервными провайдерами на случай таймаута)
    local ext_ip=""
    for ep in "https://icanhazip.com" "https://ifconfig.me" "https://api.ipify.org" "https://checkip.amazonaws.com"; do
        local candidate
        candidate=$(ip netns exec "$NETNS" curl -s -m 5 "$ep" 2>/dev/null | tr -d '[:space:]' || true)
        if [[ "$candidate" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
            ext_ip="$candidate"
            break
        fi
    done

    if [[ -n "$ext_ip" ]]; then
        info "HTTPS связность: OK"
        info "Внешний IP в netns: $ext_ip ($VPN_IFACE)"
    else
        warn "HTTPS связность: FAIL"
        all_ok=false
    fi

    if [[ "$all_ok" = false ]]; then
        warn "Некоторые сетевые проверки завершились с предупреждением."
    else
        info "Все проверки связности успешно пройдены!"
    fi
}

# ── Watchdog демон реального времени (Netlink Reconcile) ────
# Состояние демона:
LAST_HEALTHY=-1
LAST_VPN_IP=""
LAST_MTU=0
LIVENESS_FAILS=0

reconcile_state() {
    if ! netns_exists; then
        return 0
    fi

    # 1. Авто-исцеление таблицы nftables при внешнем flush ruleset
    if ! nft list table inet "$NFT_TABLE" &>/dev/null; then
        warn "Таблица $NFT_TABLE отсутствует в ядре (внешний flush?)! Восстанавливаю..."
        setup_nftables 2>/dev/null || true
    fi

    # 2. Проверка аппаратного состояния интерфейса туннеля
    local is_up=false
    local vpn_ip=""
    if vpn_is_up && vpn_has_carrier && vpn_has_ip; then
        is_up=true
        vpn_ip=$(vpn_get_ip)
    fi

    # 3. Liveness-проба (если интерфейс активен)
    local is_healthy=false
    if [[ "$is_up" = true ]]; then
        if ping -I "$VPN_IFACE" -c 1 -W 2 1.1.1.1 &>/dev/null || (command -v dig &>/dev/null && dig +short +time=2 +tries=1 @${VPN_DNS} example.com >/dev/null 2>&1); then
            is_healthy=true
            LIVENESS_FAILS=0
        else
            ((LIVENESS_FAILS++))
            if [[ $LIVENESS_FAILS -lt 2 ]]; then
                is_healthy=true # 1 льготный цикл при кратковременном сетевом джиттере
            else
                is_healthy=false
            fi
        fi
    else
        LIVENESS_FAILS=0
    fi

    # 4. Приведение маршрутизации к фактическому состоянию
    local current_mtu
    current_mtu=$(get_vpn_mtu)

    if [[ "$is_healthy" = true ]]; then
        if [[ "$LAST_HEALTHY" != "1" || "$vpn_ip" != "$LAST_VPN_IP" || "$current_mtu" != "$LAST_MTU" ]]; then
            ip link set "$VETH_HOST" mtu "$current_mtu" 2>/dev/null || true
            ip netns exec "$NETNS" ip link set "$VETH_NS" mtu "$current_mtu" 2>/dev/null || true
            ip route replace default dev "$VPN_IFACE" table "$RT_TABLE" metric 10 2>/dev/null || true

            # При смене IP туннеля очищаем старые conntrack записи и зависшие сокеты
            if [[ -n "$LAST_VPN_IP" && "$vpn_ip" != "$LAST_VPN_IP" ]]; then
                ip netns exec "$NETNS" ss -K -tu 'not dst 127.0.0.0/8' 2>/dev/null || true
                command -v conntrack &>/dev/null && conntrack -D -s "$NS_IP" 2>/dev/null || true
            fi

            LAST_HEALTHY=1
            LAST_VPN_IP="$vpn_ip"
            LAST_MTU="$current_mtu"
        fi
    else
        if [[ "$LAST_HEALTHY" != "0" ]]; then
            # Снимаем маршрут из table 200 (трафик мгновенно попадает в unreachable metric 9999)
            ip route del default dev "$VPN_IFACE" table "$RT_TABLE" metric 10 2>/dev/null || true
            # Немедленный сброс внешних сокетов клетки (loopback 127.0.0.1 сохраняется)
            ip netns exec "$NETNS" ss -K -tu 'not dst 127.0.0.0/8' 2>/dev/null || true
            command -v conntrack &>/dev/null && conntrack -D -s "$NS_IP" 2>/dev/null || true

            LAST_HEALTHY=0
            LAST_VPN_IP=""
        fi
    fi
}

watchdog_loop() {
    # Append mode (>>), исключает усечение файла до захвата блокировки
    exec 200>>"$PID_FILE"
    if ! flock -n 200; then
        exit 0
    fi
    echo "$$" > "$PID_FILE"

    LAST_HEALTHY=-1
    LAST_VPN_IP=""
    LAST_MTU=0
    LIVENESS_FAILS=0

    while netns_exists; do
        ip -o monitor link 2>/dev/null | grep --line-buffered -w "$VPN_IFACE" | while :; do
            reconcile_state </dev/null
            read -r -t 5 _ || {
                rc=$?
                if [[ $rc -le 128 && $rc -ne 0 ]]; then
                    # Pipe закрыт / EOF
                    break
                fi
            }
            # Debounce: вычитываем пачку быстрых событий за 200мс
            while read -r -t 0.2 _; do :; done
        done
        sleep 2
    done
}

start_watchdog() {
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
        info "Watchdog уже запущен в фоне (PID: $(cat "$PID_FILE"))"
        return 0
    fi

    nohup "$SCRIPT_PATH" --watchdog-loop </dev/null >/dev/null 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    disown "$pid" 2>/dev/null || true
    info "Watchdog запущен в фоне (PID: $pid)"
}

stop_watchdog() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            info "Watchdog (PID: $pid) остановлен"
        fi
        rm -f "$PID_FILE" 2>/dev/null || true
    fi
    pkill -f "${SCRIPT_PATH} --watchdog-loop" 2>/dev/null || true
}

# ── Команда 1: claude-vpn --up ──────────────────────────────
cmd_up() {
    step "Поднятие сети netns $NETNS"

    local vpn_mtu
    vpn_mtu=$(get_vpn_mtu)

    if netns_exists; then
        info "Namespace $NETNS уже существует, синхронизирую настройки"
        ip link set "$VETH_HOST" mtu "$vpn_mtu" 2>/dev/null || true
        ip netns exec "$NETNS" ip link set "$VETH_NS" mtu "$vpn_mtu" 2>/dev/null || true
        policy_up
        vpn_route
        setup_nftables
    else
        setup_netns
    fi

    start_watchdog

    echo ""
    if vpn_is_up; then
        verify_connectivity
        echo ""
        info "Сеть netns $NETNS, Policy Routing и Kill Switch активны, VPN подключён!"
    else
        warn "VPN ($VPN_IFACE) пока не подключён."
        info "Сеть netns $NETNS и Kill Switch активны (холодный старт: трафик заблокирован fail-closed)."
        info "Как только VPN подключится, интернет у Claude включится автоматически."
    fi
}

# ── Команда 2: claude-vpn --down ────────────────────────────
cmd_down() {
    step "Остановка и удаление netns $NETNS"

    # 1. Остановить watchdog
    stop_watchdog

    # 2. Очистить policy routing (table 200 и ip rule)
    policy_down

    # 3. Восстановить исходное значение net.ipv4.ip_forward
    if [[ -f "$ORIG_FWD_FILE" ]]; then
        local orig_fwd
        orig_fwd=$(cat "$ORIG_FWD_FILE" 2>/dev/null || echo 0)
        if [[ "$orig_fwd" =~ ^[01]$ ]]; then
            sysctl -w net.ipv4.ip_forward="$orig_fwd" >/dev/null 2>&1 || true
            info "Восстановлено исходное значение net.ipv4.ip_forward=$orig_fwd"
        fi
        rm -f "$ORIG_FWD_FILE" 2>/dev/null || true
    fi

    # 4. Удалить правила из inet filter forward (если были)
    if nft list chain inet filter forward &>/dev/null; then
        for handle in $(nft -a list chain inet filter forward 2>/dev/null | grep -E 'claude-vpn' | awk '{print $NF}'); do
            nft delete rule inet filter forward handle "$handle" 2>/dev/null || true
        done
    fi

    # 5. Сбросить внешние сокеты и удалить netns
    if netns_exists; then
        ip netns exec "$NETNS" ss -K -tu 'not dst 127.0.0.0/8' 2>/dev/null || true
        ip netns del "$NETNS" 2>/dev/null && info "Namespace $NETNS удалён" || warn "Не удалось удалить namespace"
    else
        info "Namespace $NETNS уже отсутствует"
    fi

    # 6. Удалить хостовой veth
    ip link del "$VETH_HOST" 2>/dev/null || true

    # 7. Удалить nftables таблицы
    nft delete table inet "$NFT_TABLE" 2>/dev/null || true
    nft delete table ip "$NFT_TABLE" 2>/dev/null || true
    info "nftables правила очищены"

    # 8. Удалить DNS конфиг
    rm -rf "/etc/netns/${NETNS}" 2>/dev/null || true

    info "Очистка завершена. Сеть отключена."
}

# ── Команда 3: claude-vpn <app> ─────────────────────────────
cmd_run() {
    local -a app_cmd=("$@")

    if [[ ${#app_cmd[@]} -eq 0 ]]; then
        err "Не указана команда для запуска"
        echo "Использование: claude-vpn <приложение> [аргументы...]"
        exit 1
    fi

    # Автоподнятие netns при вызове приложения
    if ! netns_exists; then
        warn "Сетевое пространство $NETNS не запущено! Автоматически поднимаю (--up)..."
        cmd_up
    fi

    # Разрешить непривилегированный ICMP (ping) внутри netns
    ip netns exec "$NETNS" sysctl -w net.ipv4.ping_group_range="0 2147483647" >/dev/null 2>&1 || true

    # Если watchdog не запущен — запускаем
    if [[ ! -f "$PID_FILE" ]] || ! kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
        start_watchdog
    fi

    local base_cmd
    base_cmd=$(basename "${app_cmd[0]}")

    # Разрешение бинарника Claude CLI и самовосстановление перехватчика при 'claude update'
    local local_bin_claude="${REAL_HOME}/.local/bin/claude"
    local local_bin_raw="${REAL_HOME}/.local/bin/claude-raw"
    if [[ "$base_cmd" == "claude" ]]; then
        if [[ -e "$local_bin_claude" ]] && ! grep -q "claude-vpn" "$local_bin_claude" 2>/dev/null; then
            info "Обнаружено обновление Claude CLI (npm перезаписал перехватчик). Восстанавливаю..."
            mv -f "$local_bin_claude" "$local_bin_raw"
            cat << 'EOF' > "$local_bin_claude"
#!/bin/bash
if [ "${CLAUDE_VPN_INTERNAL:-0}" = "1" ]; then
    exec "${REAL_HOME}/.local/bin/claude-raw" "$@"
fi
exec sudo /usr/local/bin/claude-vpn claude "$@"
EOF
            chmod +x "$local_bin_claude"
            chown "${REAL_USER}:${REAL_USER}" "$local_bin_claude" "$local_bin_raw" 2>/dev/null || true
            info "Перехватчик ~/.local/bin/claude успешно восстановлен!"
        fi

        if [[ -f "$local_bin_raw" ]]; then
            app_cmd[0]="$local_bin_raw"
        elif [[ -f "${REAL_HOME}/.local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe" ]]; then
            app_cmd[0]="${REAL_HOME}/.local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe"
        fi
    elif [[ "$base_cmd" == "claude-desktop" ]]; then
        if [[ -x "/usr/bin/claude-desktop" ]]; then
            app_cmd[0]="/usr/bin/claude-desktop"
        elif [[ -x "/usr/lib/claude-desktop/claude-desktop" ]]; then
            app_cmd[0]="/usr/lib/claude-desktop/claude-desktop"
        fi
        local -a electron_flags=(
            "--disable-features=AsyncDns,DnsOverHttps"
            "--password-store=basic"
        )
        for flag in "${electron_flags[@]}"; do
            if [[ ! " ${app_cmd[*]} " =~ " ${flag} " ]]; then
                app_cmd+=("$flag")
            fi
        done
    fi

    # Уведомление о состоянии VPN
    if ! vpn_is_up; then
        warn "VPN ($VPN_IFACE) сейчас отключён! Приложение запущено без доступа в сеть (Fail-Closed)."
        warn "Интернет появится автоматически сразу после подключения VPN."
    fi

    # Подготовка безопасного прокси для уведомлений (xdg-dbus-proxy)
    local notify_proxy_sock="${XDG_RUNTIME}/claude_vpn_notify.sock"
    local notify_proxy_pid=""
    if command -v xdg-dbus-proxy &>/dev/null && [[ -S "${XDG_RUNTIME}/bus" ]]; then
        rm -f "$notify_proxy_sock"
        xdg-dbus-proxy "${XDG_RUNTIME}/bus" "$notify_proxy_sock" --filter --talk=org.freedesktop.Notifications >/dev/null 2>&1 &
        notify_proxy_pid=$!
        chown "${REAL_UID}:${REAL_GID}" "$notify_proxy_sock" 2>/dev/null || true
    fi

    cleanup_proxy() {
        if [[ -n "$notify_proxy_pid" ]]; then
            kill "$notify_proxy_pid" 2>/dev/null || true
        fi
        rm -f "$notify_proxy_sock" 2>/dev/null || true
    }
    trap cleanup_proxy EXIT

    # ── Окружение GUI / CLI ─────────────────────────────────
    local x_display="${DISPLAY:-:0}"
    local x_authority="${XAUTHORITY:-${XDG_RUNTIME}/gdm/Xauthority}"
    if [[ ! -f "$x_authority" ]]; then
        x_authority="${REAL_HOME}/.Xauthority"
    fi

    local wayland_display="${WAYLAND_DISPLAY:-}"
    local wayland_socket="${XDG_RUNTIME}/${wayland_display}"
    local dbus_addr="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME}/bus}"

    local -a env_vars=(
        "CLAUDE_VPN_INTERNAL=1"
        "BROWSER=${JAIL_XDG_OPEN}"
        "HOME=${REAL_HOME}"
        "USER=${REAL_USER}"
        "LOGNAME=${REAL_USER}"
        "SHELL=/bin/bash"
        "TERM=${TERM:-xterm-256color}"
        "PATH=${REAL_HOME}/bin:${REAL_HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"
        "LANG=${LANG:-ru_RU.UTF-8}"
        "TZ=${CLAUDE_TZ}"
        "DISPLAY=${x_display}"
        "XAUTHORITY=${x_authority}"
        "XDG_RUNTIME_DIR=${XDG_RUNTIME}"
        "XDG_DATA_HOME=${REAL_HOME}/.local/share"
        "XDG_CONFIG_HOME=${REAL_HOME}/.config"
        "XDG_CACHE_HOME=${REAL_HOME}/.cache"
        "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-x11}"
        "PIPEWIRE_RUNTIME_DIR=${XDG_RUNTIME}"
        "ELECTRON_OZONE_PLATFORM_HINT=auto"
        "SSH_AUTH_SOCK="
    )

    if [[ -n "$wayland_display" && -S "$wayland_socket" ]]; then
        env_vars+=("WAYLAND_DISPLAY=${wayland_display}")
    fi

    # Создать синтетический стабильный machine-id для клетки
    local synth_mid_file="/run/claude_vpn_machine_id"
    if [[ ! -f "$synth_mid_file" ]]; then
        echo -n "claude_vpn_jail_${REAL_USER}" | sha256sum | head -c 32 > "$synth_mid_file"
        echo "" >> "$synth_mid_file"
        chmod 0644 "$synth_mid_file" 2>/dev/null || true
    fi

    # Изоляция bwrap: маскировка системных и сессионных сокетов, синтетический отпечаток
    local -a bwrap_cmd=(
        bwrap --dev-bind / /
        --unshare-uts
        --hostname claude-jail
        --tmpfs /run/systemd/resolve
        --tmpfs /run/dbus
        --ro-bind "/etc/netns/${NETNS}/resolv.conf" /run/systemd/resolve/stub-resolv.conf
        --ro-bind "/etc/netns/${NETNS}/resolv.conf" /run/systemd/resolve/resolv.conf
        --ro-bind "$synth_mid_file" /etc/machine-id
    )
    if [[ ! -L /var/lib/dbus/machine-id && -f /var/lib/dbus/machine-id ]]; then
        bwrap_cmd+=(--ro-bind "$synth_mid_file" /var/lib/dbus/machine-id)
    fi
    if [[ -d "/sys/devices/virtual/dmi/id" ]]; then
        bwrap_cmd+=(--tmpfs "/sys/devices/virtual/dmi/id")
    fi
    if [[ ! -L /etc/resolv.conf ]]; then
        bwrap_cmd+=(--ro-bind "/etc/netns/${NETNS}/resolv.conf" /etc/resolv.conf)
    fi

    # Маскировка хостовой сессионной шины D-Bus (AF_UNIX сокет)
    if [[ -e "${XDG_RUNTIME}/bus" ]]; then
        bwrap_cmd+=(--ro-bind /dev/null "${XDG_RUNTIME}/bus")
    fi

    # Маскировка сокетов systemd пользователя (RCE на хост через systemd --user)
    if [[ -d "${XDG_RUNTIME}/systemd" ]]; then
        bwrap_cmd+=(--tmpfs "${XDG_RUNTIME}/systemd")
    fi

    # Маскировка сокетов GnuPG (ssh-agent, gpg-agent)
    if [[ -d "${XDG_RUNTIME}/gnupg" ]]; then
        bwrap_cmd+=(--tmpfs "${XDG_RUNTIME}/gnupg")
    fi

    # Маскировка сокетов связки ключей GNOME / KWallet
    if [[ -d "${XDG_RUNTIME}/keyring" ]]; then
        bwrap_cmd+=(--tmpfs "${XDG_RUNTIME}/keyring")
    fi

    # Скрыть автоактивацию D-Bus портала хоста
    if [[ -f "/usr/share/dbus-1/services/org.freedesktop.portal.Desktop.service" ]]; then
        bwrap_cmd+=(--ro-bind /dev/null /usr/share/dbus-1/services/org.freedesktop.portal.Desktop.service)
    fi
    if [[ -f "$JAIL_XDG_OPEN" ]]; then
        bwrap_cmd+=(--ro-bind "$JAIL_XDG_OPEN" /usr/bin/xdg-open)
    fi

    # Отключить обращение Electron/GTK к D-Bus-порталам
    env_vars+=("GTK_USE_PORTAL=0" "GDK_DEBUG=no-portals")

    local -a dbus_wrapper=()
    if command -v dbus-run-session >/dev/null 2>&1; then
        dbus_wrapper=(dbus-run-session --)
    fi

    # Прямой exec через setpriv до bwrap (сброс root привилегий перед входом в mntns)
    exec ip netns exec "$NETNS" \
        setpriv --init-groups --no-new-privs --inh-caps=-all --reuid="$REAL_UID" --regid="$REAL_GID" \
        env "${env_vars[@]}" GTK_USE_PORTAL=0 GDK_DEBUG=no-portals \
        "${bwrap_cmd[@]}" \
        -- \
        "${dbus_wrapper[@]}" \
        "${app_cmd[@]}"
}

# ── Статус ──────────────────────────────────────────────────
show_status() {
    echo -e "${CYAN}=== Статус claude-vpn (Hardened Zero-Trust) ===${NC}"
    echo ""

    local vpn_mtu
    vpn_mtu=$(get_vpn_mtu)

    # VPN
    if vpn_is_up; then
        local vpn_ip
        vpn_ip=$(vpn_get_ip)
        info "VPN ($VPN_IFACE): ПОДКЛЮЧЁН — $vpn_ip (MTU: $vpn_mtu)"
    else
        warn "VPN ($VPN_IFACE): ОТКЛЮЧЁН (Fail-Closed Kill Switch активен)"
    fi

    # Netns
    if netns_exists; then
        info "Namespace $NETNS: АКТИВЕН"
        echo "  Интерфейсы хоста:"
        local host_veth_mtu
        host_veth_mtu=$(ip -o link show dev "$VETH_HOST" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="mtu") print $(i+1)}')
        echo "    $VETH_HOST MTU: ${host_veth_mtu:-unknown}"
        echo "  Интерфейсы в netns:"
        local ns_veth_mtu
        ns_veth_mtu=$(ip netns exec "$NETNS" ip -o link show dev "$VETH_NS" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="mtu") print $(i+1)}')
        echo "    $VETH_NS MTU: ${ns_veth_mtu:-unknown}"
        ip netns exec "$NETNS" ip -4 addr show 2>/dev/null | grep -E "inet " | sed 's/^/    /'

        echo "  IPv6 в netns:"
        local ip6_state
        ip6_state=$(ip netns exec "$NETNS" sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null || echo "0")
        if [[ "$ip6_state" == "1" ]]; then
            echo "    disable_ipv6 = 1 (ОТКЛЮЧЁН / ЗАЩИТА АКТИВНА)"
        else
            echo "    ВКЛЮЧЁН"
        fi
        echo "  Маршруты netns:"
        local routes
        routes=$(ip netns exec "$NETNS" ip route show 2>/dev/null)
        if [[ -n "$routes" ]]; then
            echo "$routes" | sed 's/^/    /'
        fi
        echo "  DNS netns:"
        cat "/etc/netns/${NETNS}/resolv.conf" 2>/dev/null | sed 's/^/    /'

        echo ""
        verify_connectivity
    else
        warn "Namespace $NETNS: НЕ ЗАПУЩЕН"
    fi

    # Policy Routing
    echo ""
    info "Policy Routing (table $RT_TABLE, prio $RT_PRIO):"
    ip rule show 2>/dev/null | grep -E "lookup $RT_TABLE" | sed 's/^/    /' || echo "    [Правило ip rule отсутствует]"
    ip route show table "$RT_TABLE" 2>/dev/null | sed 's/^/    /' || echo "    [Таблица $RT_TABLE пуста]"

    # Watchdog
    echo ""
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
        info "Watchdog демон: РАБОТАЕТ (PID: $(cat "$PID_FILE"))"
    else
        warn "Watchdog демон: НЕ ЗАПУЩЕН"
    fi

    # nftables
    echo ""
    if nft list table inet "$NFT_TABLE" &>/dev/null; then
        info "nftables таблица inet $NFT_TABLE: АКТИВНА"
        nft list chain inet "$NFT_TABLE" forward 2>/dev/null | grep -E "drop|accept" | sed 's/^/    /'
    else
        warn "nftables таблица inet $NFT_TABLE: НЕ НАЙДЕНА"
    fi
}

# ── Точка входа ─────────────────────────────────────────────
main() {
    # Внутренний вызов демона watchdog
    if [[ "${1:-}" == "--watchdog-loop" ]]; then
        watchdog_loop
        exit 0
    fi

    check_root "$@"

    case "${1:-}" in
        --up)
            cmd_up
            ;;
        --down|--teardown|--clean)
            cmd_down
            ;;
        --status|-s)
            show_status
            ;;
        --help|-h)
            echo "Использование: claude-vpn <команда>"
            echo ""
            echo "Управление сетью:"
            echo "  --up               Поднять netns, veth, policy routing, nftables и watchdog в фоне"
            echo "  --down             Полностью остановить и удалить netns, правила и watchdog"
            echo "  --status, -s       Показать текущий статус сети, VPN, routing и watchdog"
            echo "  --help, -h         Показать эту справку"
            echo ""
            echo "Запуск приложений (при необходимости поднимет сеть автоматически):"
            echo "  claude-desktop     Запустить Claude Desktop (Electron)"
            echo "  claude             Запустить Claude CLI"
            echo "  bash               Открыть отладочный шелл в netns"
            echo "  <команда...>       Запустить любую произвольную команду в netns"
            echo ""
            echo "Примеры:"
            echo "  claude-vpn --up"
            echo "  claude-vpn claude-desktop"
            echo "  claude-vpn claude"
            echo "  claude-vpn --down"
            ;;
        "")
            err "Не указана команда"
            echo "Используй: claude-vpn --help"
            exit 1
            ;;
        *)
            cmd_run "$@"
            ;;
    esac
}

main "$@"
